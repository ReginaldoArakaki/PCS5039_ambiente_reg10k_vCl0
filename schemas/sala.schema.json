{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReginaldoArakaki/PCS5039_ambiente_reg10k_vCl0/schemas/sala.schema.json",
  "title": "Estrutura da sala (incremento 0)",
  "type": "object",
  "required": [
    "id",
    "largura_m",
    "profundidade_m",
    "passo_ms",
    "porta",
    "zonas_cegas",
    "ocupantes",
    "dispositivos",
    "controle",
    "plataforma"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "largura_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "profundidade_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "passo_ms": {
      "type": "integer",
      "enum": [
        100
      ]
    },
    "porta": {
      "type": "object",
      "required": [
        "id",
        "x_inicio",
        "x_fim",
        "y"
      ]
    },
    "zonas_cegas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "x0",
          "y0",
          "x1",
          "y1"
        ]
      }
    },
    "lampada": {
      "type": "object"
    },
    "interruptor": {
      "type": "object"
    },
    "ocupantes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "tipo"
        ],
        "properties": {
          "tipo": {
            "enum": [
              "PESSOA",
              "CACHORRO"
            ]
          }
        }
      }
    },
    "dispositivos": {
      "type": "object",
      "required": [
        "SA-01",
        "SP-01",
        "ATU-01",
        "LAMP-01",
        "INT-01"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "tipo",
          "ideal",
          "realista"
        ],
        "properties": {
          "ideal": {
            "type": "object",
            "properties": {
              "latencia_ms": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "latencia_ms"
            ]
          },
          "realista": {
            "type": "object",
            "properties": {
              "latencia_ms": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "latencia_ms"
            ]
          }
        }
      }
    },
    "controle": {
      "type": "object",
      "required": [
        "t_apagamento_ms",
        "t_manual_ms",
        "t_heartbeat_falha_ms",
        "t_confirmacao_ms",
        "t_retentativa_ms"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "plataforma": {
      "type": "object",
      "description": "v0dt: canal, DTReg10k-R, comandos remotos, configuração e app",
      "required": [
        "canal",
        "app",
        "resumo_ms",
        "limite_atualidade_ms",
        "validade_comando_ms",
        "prazo_resultado_ms",
        "reenvio_ms",
        "reconexao_min_ms",
        "reconexao_max_ms",
        "reconexao_jitter",
        "t_apagamento_limites_ms"
      ],
      "properties": {
        "descricao": {
          "type": "string"
        },
        "canal": {
          "type": "object",
          "required": [
            "ideal",
            "realista"
          ],
          "properties": {
            "ideal": {
              "type": "object",
              "required": [
                "latencia_ms",
                "p_perda",
                "p_duplicacao"
              ],
              "properties": {
                "latencia_ms": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "p_perda": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "p_duplicacao": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            },
            "realista": {
              "type": "object",
              "required": [
                "latencia_ms",
                "p_perda",
                "p_duplicacao"
              ],
              "properties": {
                "latencia_ms": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "p_perda": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "p_duplicacao": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          }
        },
        "app": {
          "type": "object",
          "required": [
            "ideal",
            "realista"
          ],
          "properties": {
            "ideal": {
              "type": "object",
              "required": [
                "latencia_ms"
              ],
              "properties": {
                "latencia_ms": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "realista": {
              "type": "object",
              "required": [
                "latencia_ms"
              ],
              "properties": {
                "latencia_ms": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "minimum": 0
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            }
          }
        },
        "resumo_ms": {
          "type": "integer",
          "minimum": 0
        },
        "limite_atualidade_ms": {
          "type": "integer",
          "minimum": 0
        },
        "validade_comando_ms": {
          "type": "integer",
          "minimum": 0
        },
        "prazo_resultado_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reenvio_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reconexao_min_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reconexao_max_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reconexao_jitter": {
          "type": "object",
          "properties": {
            "ideal": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "realista": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "t_apagamento_limites_ms": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
