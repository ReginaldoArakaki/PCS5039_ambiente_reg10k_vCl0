{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReginaldoArakaki/PCS5039_ambiente_reg10k_vCl0/schemas/catalogo.schema.json",
  "title": "Índice do catálogo (catalogo.json)",
  "type": "object",
  "required": [
    "versao",
    "incremento",
    "sala",
    "cenarios",
    "controladores",
    "execucoes",
    "problemas"
  ],
  "properties": {
    "versao": {
      "type": "string"
    },
    "incremento": {
      "type": "integer",
      "description": "0 = v0; 1 = v0dt/v0dta; 2 = v1dt"
    },
    "sala": {
      "anyOf": [
        {
          "$ref": "sala.schema.json"
        },
        {
          "$ref": "residencia.schema.json"
        }
      ],
      "description": "Ambiente de referência da página: a sala da v0 ou, nas versões sem ela, a residência do primeiro cenário (nucleo-v1.2)"
    },
    "cenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "titulo",
          "tipo",
          "modo",
          "requisitos"
        ]
      }
    },
    "controladores": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "execucoes": {
      "type": "array",
      "items": {
        "$ref": "metricas.schema.json"
      }
    },
    "problemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambientes": {
      "type": "object",
      "description": "v1dt: arquivos de ambiente usados pelos cenários"
    }
  }
}
