{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReginaldoArakaki/PCS5039_ambiente_reg10k_vCl0/schemas/metricas.schema.json",
  "title": "Resultado de uma execução (metricas.json)",
  "type": "object",
  "required": [
    "cenario",
    "controlador",
    "semente",
    "modo",
    "hash_eventos",
    "metricas",
    "invariantes",
    "assercoes",
    "requisitos_ok"
  ],
  "properties": {
    "cenario": {
      "type": "string"
    },
    "controlador": {
      "type": "string"
    },
    "semente": {
      "type": "integer"
    },
    "modo": {
      "enum": [
        "IDEAL",
        "REALISTA"
      ]
    },
    "hash_eventos": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metricas": {
      "type": "object",
      "required": [
        "desperdicio_s",
        "escuro_com_ocupante_s",
        "apagamentos_indevidos",
        "acionamentos",
        "latencia_reacao_ms_p95",
        "atualidade_gemeo_ms_p95",
        "comandos_vencidos_executados",
        "efeitos_duplicados_remotos",
        "espelho_fiel_s",
        "erro_de_percepcao_s",
        "erro_de_sincronizacao_s",
        "espelho_nao_afirma_s"
      ],
      "properties": {
        "desperdicio_s": {
          "type": "number"
        },
        "escuro_com_ocupante_s": {
          "type": "number"
        },
        "apagamentos_indevidos": {
          "type": "integer",
          "minimum": 0
        },
        "acionamentos": {
          "type": "integer",
          "minimum": 0
        },
        "latencia_reacao_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "atualidade_gemeo_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "comando_remoto_ms_p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "reconciliacao_ms_max": {
          "type": [
            "number",
            "null"
          ]
        },
        "comandos_vencidos_executados": {
          "type": "integer",
          "minimum": 0
        },
        "efeitos_duplicados_remotos": {
          "type": "integer",
          "minimum": 0
        },
        "comandos_remotos": {
          "type": "integer",
          "minimum": 0
        },
        "divergencia_alem_prazo_s": {
          "type": "number",
          "minimum": 0
        },
        "espelho_fiel_s": {
          "type": "number",
          "minimum": 0
        },
        "erro_de_percepcao_s": {
          "type": "number",
          "minimum": 0
        },
        "erro_de_sincronizacao_s": {
          "type": "number",
          "minimum": 0
        },
        "espelho_nao_afirma_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "invariantes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^OR-(0[1-9]|1[0-2])$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "ok",
          "violacoes"
        ]
      }
    },
    "assercoes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "ok",
          "nivel",
          "detalhe"
        ]
      }
    },
    "requisitos_ok": {
      "type": "boolean"
    },
    "aprovado": {
      "type": "boolean"
    },
    "modo_rede": {
      "enum": [
        "IDEAL",
        "REALISTA"
      ]
    },
    "versao_cenario": {
      "enum": [
        "v0",
        "v0dt",
        "v0dta"
      ]
    },
    "execucao_pareada": {
      "type": "boolean"
    },
    "espelho": {
      "type": "object",
      "required": [
        "segmentos",
        "amostras"
      ],
      "properties": {
        "segmentos": {
          "type": "object",
          "properties": {
            "R": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "enum": [
                      "FIEL",
                      "PERCEPCAO",
                      "SINCRONIZACAO",
                      "NAO_AFIRMA"
                    ]
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            },
            "L": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "integer"
                  },
                  {
                    "enum": [
                      "FIEL",
                      "PERCEPCAO",
                      "SINCRONIZACAO",
                      "NAO_AFIRMA"
                    ]
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              }
            }
          }
        },
        "amostras": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": [
              "rotulo",
              "t_ms",
              "real",
              "L",
              "R"
            ],
            "properties": {
              "rotulo": {
                "enum": [
                  "inicio",
                  "meio",
                  "fim"
                ]
              },
              "L": {
                "type": "object",
                "required": [
                  "classe"
                ],
                "properties": {
                  "classe": {
                    "enum": [
                      "FIEL",
                      "PERCEPCAO",
                      "SINCRONIZACAO",
                      "NAO_AFIRMA"
                    ]
                  }
                }
              },
              "R": {
                "type": "object",
                "required": [
                  "classe"
                ],
                "properties": {
                  "classe": {
                    "enum": [
                      "FIEL",
                      "PERCEPCAO",
                      "SINCRONIZACAO",
                      "NAO_AFIRMA"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
